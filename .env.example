# Copy to .env (make init). Every variable your code reads must be listed here.

# Server — inside Docker the server must bind 0.0.0.0
SERVER_HOST=0.0.0.0
SERVER_PORT=5000

# Client — inside Docker use the service name "server"; natively use "localhost"
CLIENT_TARGET_HOST=server
CLIENT_TARGET_PORT=5000

LOG_LEVEL=INFO

# Close clients that send no complete frame for this many milliseconds.
CLIENT_READ_TIMEOUT_MS=120000
